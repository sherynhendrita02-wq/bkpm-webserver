# Acara 30 - Langkah 4: lapisan pertahanan tambahan.
# Idealnya app/ berada di luar document root; berkas ini melindungi bila app/ ikut terunggah ke dalam public_html.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
